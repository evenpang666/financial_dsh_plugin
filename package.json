{
  "name": "dsh-financial",
  "version": "0.7.0",
  "type": "module",
  "description": "知衡 · A股、港股、美股研究、持仓、日报、K线回测与模拟，复用 DSH Web 智能体、模型与凭据。",
  "icon": "./web/icon.svg",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/launch.mjs",
    "dev": "node scripts/launch.mjs --no-open",
    "stop": "node scripts/stop.mjs",
    "dsh:register": "node scripts/register-plugin.mjs",
    "dsh": "node scripts/finance-dsh.mjs",
    "test": "node --test tests/web-*.test.mjs tests/ai-simulation.test.mjs tests/git-hygiene.test.mjs tests/test_portfolio_tool.mjs tests/test_report_visuals.cjs",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:service": "node --test tests/dsh-service.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "finance"
  ],
  "license": "MIT"
}
